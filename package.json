{
  "name": "passport-quest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Passport Quest — a Scrambly-styled playable (Simula take-home)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/inline.mjs",
    "preview": "vite preview",
    "serve:dist": "python3 -m http.server 4173 --directory dist",
    "package": "npm run build && node scripts/package.mjs",
    "perf": "node scripts/perfcheck.mjs",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
